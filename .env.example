# Local development proxy target. This is an origin, not an API path.
CLOUD_API_ORIGIN=https://agentrelay.com

# Public browser configuration. Never put credentials in VITE_ variables.
# Defaults to CLOUD_API_ORIGIN in development, agentrelay.com in production.
# VITE_CLOUD_ORIGIN=https://agentrelay.com

# In development, leave unset to use the restricted local proxy (/cloud-api).
# In a deployed static build, defaults to the direct Cloud API below.
# VITE_CLOUD_API_URL=https://agentrelay.com/cloud/api/v1
